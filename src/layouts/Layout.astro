---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gorixo — WhatsApp Commerce, Engineered",
  description = "Gorixo builds and runs your WhatsApp storefront. Submit your business, we execute.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <div class="grain"></div>
    <slot />
  </body>
</html>
